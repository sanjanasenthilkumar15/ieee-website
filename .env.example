# Copy to .env (or set these in the systemd service / docker-compose.yml).
# None are required for local development.

# Public address of the site, used for sitemap, robots.txt and social previews.
SITE_URL=https://ieee.rmkec.ac.in

# Where the database (site.db) and uploaded files live. Must be an absolute path
# in production. Default: ./data next to the project. BACK THIS FOLDER UP.
DATA_DIR=

# Set to true on test/review copies so search engines don't index them.
SITE_NOINDEX=

# Port the Node server listens on (default 3000). Put nginx/Apache/IIS in front for HTTPS.
PORT=3000
